# ==============================================================================
# CloudMesh Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your cloud provider tokens,
# notifications keys, and local daemon settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Configuration
# ------------------------------------------------------------------------------
# API Token requires Zone:Read and DNS:Read permissions.
CLOUDFLARE_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 2. Hetzner Cloud Projects Configuration
# ------------------------------------------------------------------------------
# Add as many projects as needed by incrementing the project suffix (e.g. _1, _2).
# Both TOKEN and PROJECT_NAME parameters must be specified for each project.
HETZNER_TOKEN_1=your_hetzner_project_1_api_token
HETZNER_PROJECT_NAME_1=Production

HETZNER_TOKEN_2=your_hetzner_project_2_api_token
HETZNER_PROJECT_NAME_2=Staging_And_Dev

# ------------------------------------------------------------------------------
# 3. Notification Integrations
# ------------------------------------------------------------------------------
# A. Google Chat (Spaces Webhook)
# Paste the Google Chat space incoming webhook URL.
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAAxxxxxx/webhooks/your-webhook-token

# B. Slack Integration
# Bot User OAuth Token (starting with xoxb-) and Channel ID where messages post.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=C0123456789

# ------------------------------------------------------------------------------
# 4. Feature Toggles (true/false)
# ------------------------------------------------------------------------------
# Disable/enable specific capabilities during scheduled audit runs.
GENERATE_REPORTS=true
ENABLE_SLACK_NOTIFICATIONS=true
ENABLE_GOOGLE_CHAT_NOTIFICATIONS=true

# ------------------------------------------------------------------------------
# 5. Scheduled Daemon Mode & Snapshot Pruning
# ------------------------------------------------------------------------------
# MONITORING_INTERVAL_SECS: Interval in seconds between continuous audit scans.
# Set to '0' (or omit) to run the audit once as a cron command and exit.
MONITORING_INTERVAL_SECS=300

# MAX_HISTORICAL_SNAPSHOTS: Maximum quantity of previous snapshot JSON reports
# preserved under 'reports/snapshots/' for visual comparison diffs.
MAX_HISTORICAL_SNAPSHOTS=10

# ------------------------------------------------------------------------------
# 6. Telemetry & Metrics Target
# ------------------------------------------------------------------------------
# Pushgateway metrics scraping location.
PUSHGATEWAY_URL=http://localhost:9091

# ------------------------------------------------------------------------------
# 7. Dashboard Security
# ------------------------------------------------------------------------------
# Passcode required to unlock the React frontend dashboard.
# If left blank, the dashboard will remain public.
DASHBOARD_PASSWORD=your_secure_passcode_here

# ------------------------------------------------------------------------------
# 8. Deployment Target Configuration (Local Only)
# ------------------------------------------------------------------------------
# Target Linux server configuration for local deployment scripts (deploy.sh/ps1).
DEPLOY_TARGET_IP=49.13.65.81
DEPLOY_TARGET_USER=root
DEPLOY_TARGET_DIR=/home/cloudmesh


